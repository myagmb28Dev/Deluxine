# App Configuration
PORT=enter_port
CORS_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL)
DATABASE_URL=enter_database_url
DB_HOST=enter_db_host
DB_PORT=enter_db_port
DB_USERNAME=enter_db_username
DB_PASSWORD=enter_db_password
DB_NAME=enter_db_name
DB_SSL=enter_db_ssl_true_or_false

# Redis Configuration (BullMQ / Cache)
REDIS_URL=enter_redis_url
REDIS_HOST=enter_redis_host
REDIS_PORT=enter_redis_port
REDIS_PASSWORD=enter_redis_password
REDIS_DB=enter_redis_db
REDIS_TLS=enter_redis_tls_true_or_false

FIREBASE_SERVICE_ACCOUNT_JSON=enter_firebase_service_account_json
FIREBASE_SERVICE_ACCOUNT_JSON_B64=enter_base64_firebase_service_account_json


# External AI Engines
OPENROUTER_API_KEY=enter_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=600000
AI_POSE_ENGINE_URL=enter_ai_pose_engine_url

# Cloudflare R2 (S3 compatible)
R2_ACCESS_KEY_ID=enter_r2_access_key_id
R2_SECRET_ACCESS_KEY=enter_r2_secret_access_key
R2_ENDPOINT=https://enter_account_id.r2.cloudflarestorage.com
R2_BUCKET=enter_r2_bucket
R2_KEY_PREFIX=uploads
R2_SIGNED_GET_TTL_SEC=600
R2_SIGNED_PUT_TTL_SEC=60

ENABLE_QUEUE_PROCESSORS=true
